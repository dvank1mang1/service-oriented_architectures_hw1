flowchart TB
    customer(["Покупатель<br/>[Person]<br/>Лента, корзина, оплата заказа"]):::person
    seller(["Продавец<br/>[Person]<br/>Товары, цены и остатки"]):::person
    psp["Платёжный провайдер<br/>[External System]<br/>Hosted checkout, эквайринг, возврат"]:::external
    delivery["Email/SMS провайдер<br/>[External System]<br/>Доставка статусных сообщений"]:::external
    subgraph marketplace["Marketplace · Software System"]
    web["Web App<br/>[Container: TypeScript / React SPA]<br/>Интерфейс покупателя и продавца"]:::service
    gateway["API Gateway<br/>[Container: Nginx]<br/>TLS, маршрутизация, rate limit"]:::service
    identity["Identity Service<br/>[Container: Python / HTTP API]<br/>Аккаунты, роли, контакты и сессии"]:::service
    catalog["Catalog Service<br/>[Container: Python / HTTP API]<br/>Товары, цены, резервы; реализован health"]:::service
    feed["Feed Service<br/>[Container: Python / HTTP API]<br/>Лента и сигналы просмотров"]:::service
    order["Order Service<br/>[Container: Python / HTTP API]<br/>Корзина, сумма и статусы заказа"]:::service
    payment["Payment Service<br/>[Container: Python / HTTP API]<br/>Платежи, проводки, комиссия, возвраты"]:::service
    notification["Notification Service<br/>[Container: Python / worker]<br/>Шаблоны, повторы, доставка"]:::service
    bus["Event Broker<br/>[Container: RabbitMQ / AMQP]<br/>Durable queues, подтверждения, DLQ"]:::service
    identity_db[("Identity DB<br/>[Container: PostgreSQL]<br/>Аккаунты, роли, контакты")]:::db
    catalog_db[("Catalog DB<br/>[Container: PostgreSQL]<br/>Товары, предложения, резервы")]:::db
    media[("Media Storage<br/>[Container: S3-compatible]<br/>Медиа; владелец Catalog")]:::db
    index[("Feed Index<br/>[Container: OpenSearch]<br/>Проекция товаров")]:::db
    features[("Feed Features / Cache<br/>[Container: Redis]<br/>Интересы, кеш, fallback-лента")]:::db
    order_db[("Order DB<br/>[Container: PostgreSQL]<br/>Корзины, снимки цен, история")]:::db
    payment_db[("Payment DB<br/>[Container: PostgreSQL]<br/>Платежи, ledger, возвраты")]:::db
    notification_db[("Notification DB<br/>[Container: PostgreSQL]<br/>Контакты-проекция, попытки")]:::db
