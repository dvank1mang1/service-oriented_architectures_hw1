---
title: marketplace - c4 container diagram (planned system)
config:
  layout: elk
  theme: base
  themeVariables:
    fontFamily: Arial
    fontSize: 15px
  flowchart:
    htmlLabels: false
    nodeSpacing: 45
    rankSpacing: 70
---
flowchart TB
    customer(["buyer<br/>[person]<br/>browse, add to cart, pay"]):::person
    seller(["seller<br/>[person]<br/>products, prices and stock"]):::person
    psp["payment provider<br/>[external system]<br/>payment page, processing, refunds"]:::external
    delivery["email/sms provider<br/>[external system]<br/>deliver order updates"]:::external
    subgraph marketplace["marketplace · software system"]
    web["web app<br/>[container: typescript / react spa]<br/>buyer and seller interface"]:::service
    gateway["api gateway<br/>[container: nginx]<br/>tls, routing, request limits"]:::service
    identity["identity service<br/>[container: python / http api]<br/>accounts, roles, contacts, sessions"]:::service
    catalog["catalog service<br/>[container: python / http api]<br/>products, prices, stock holds; health only implemented"]:::service
    feed["feed service<br/>[container: python / http api]<br/>personal feed and browsing signals"]:::service
    order["order service<br/>[container: python / http api]<br/>cart, totals, order status"]:::service
    payment["payment service<br/>[container: python / http api]<br/>payments, records, fees, refunds"]:::service
    notification["notification service<br/>[container: python / worker]<br/>templates, retries, delivery"]:::service
    bus["event broker<br/>[container: rabbitmq / amqp]<br/>durable queues, confirmations, failed messages"]:::service
    identity_db[("identity db<br/>[container: postgresql]<br/>accounts, roles, contacts")]:::db
    catalog_db[("catalog db<br/>[container: postgresql]<br/>products, offers, stock holds")]:::db
    media[("media storage<br/>[container: s3-compatible]<br/>images owned by catalog")]:::db
    index[("feed index<br/>[container: opensearch]<br/>searchable product copy")]:::db
    features[("feed features / cache<br/>[container: redis]<br/>interests, cache, general feed")]:::db
    order_db[("order db<br/>[container: postgresql]<br/>carts, saved prices, history")]:::db
    payment_db[("payment db<br/>[container: postgresql]<br/>payments, ledger, refunds")]:::db
    notification_db[("notification db<br/>[container: postgresql]<br/>copied contacts, delivery attempts")]:::db
    end
    customer -->|"browse and buy<br/>https, sync"| web
    seller -->|"manage products<br/>https, sync"| web
    web -->|"api requests<br/>https/json, sync"| gateway
    web -->|"pay on provider page<br/>https, sync"| psp
    gateway -->|"accounts and tokens<br/>http/json, sync"| identity
    gateway -->|"products and images<br/>http/json, sync"| catalog
    gateway -->|"feed and views<br/>http/json, sync"| feed
    gateway -->|"cart and checkout<br/>http/json, sync"| order
    order -->|"reserve / confirm / release<br/>http/json, sync"| catalog
    feed -->|"snapshot to rebuild index<br/>http/json, sync"| catalog
    order -->|"payment request / status / refund<br/>http/json, sync"| payment
    payment -->|"pay, check result, refund<br/>https/json, sync"| psp
    psp -.->|"signed webhook<br/>https, async callback"| payment
    notification -->|"submit message<br/>https/json, sync"| delivery
    identity -->|"read and write<br/>sql"| identity_db
    catalog -->|"read and write<br/>sql"| catalog_db
    catalog -->|"read and write<br/>s3 api"| media
    feed -->|"index and search<br/>https/json"| index
    feed -->|"interests and cache<br/>resp"| features
    order -->|"read and write<br/>sql"| order_db
    payment -->|"read and write<br/>sql"| payment_db
    notification -->|"read and write<br/>sql"| notification_db
    identity -.->|"profile changed<br/>amqp, async"| bus
    catalog -.->|"product / stock changed<br/>amqp, async"| bus
    order -.->|"order status / cart changed<br/>amqp, async"| bus
    payment -.->|"payment status changed<br/>amqp, async"| bus
    bus -.->|"products, carts, purchases<br/>amqp, async"| feed
    bus -.->|"payment results<br/>amqp, async"| order
    bus -.->|"profiles and order status<br/>amqp, async"| notification
    classDef person fill:#163861,color:#fff,stroke:#163861;
    classDef external fill:#626b78,color:#fff,stroke:#48515f;
    classDef service fill:#286bb0,color:#fff,stroke:#174675;
    classDef db fill:#e6f0fb,color:#14395e,stroke:#286bb0;
    style marketplace fill:#f8fafc,stroke:#64748b,stroke-dasharray:6 4;
